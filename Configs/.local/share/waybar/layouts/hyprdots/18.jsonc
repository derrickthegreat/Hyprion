//   --// 13's split pills with 17's modules, plus the system stats //--   //
{
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    // mpris hides itself with no player, so it shares a pill instead of leaving an empty one //
    "modules-left": [
        "group/pill#left"
    ],
    "group/pill#left": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces",
            "wlr/taskbar",
            "mpris"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "custom/hyprsunset",
            "custom/caffeine",
            "clock",
            "custom/updates",
            "custom/keybindhint",
            "custom/gamemode",
            "custom/weather"
        ]
    },
    "modules-right": [
        "group/pill#system",
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3",
        "group/pill#right4"
    ],
    "group/pill#system": {
        "orientation": "inherit",
        "modules": [
            "custom/gpuinfo",
            "custom/cpuinfo",
            "custom/sensorsinfo"
        ]
    },
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network",
            "bluetooth",
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "privacy",
            "tray",
            "battery"
        ]
    },
    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/wallchange",
            "custom/theme",
            "custom/wbar"
        ]
    },
    // custom/dunst and custom/swaync each hide unless their daemon is running //
    "group/pill#right4": {
        "orientation": "inherit",
        "modules": [
            "custom/cliphist",
            "custom/dunst",
            "custom/swaync",
            "custom/hyde-menu",
            "custom/power"
        ]
    }
}
