{
    "custom/wbar": {
        "format": " {0}", //    //
        "rotate": 0,
        "tooltip-format": "\uf205 Switch bar | \uf2d5 dock",
        "on-click": "setsid -f hyde-shell waybar -n",
        "on-click-right": "setsid -f hyde-shell waybar -p",
        "on-click-middle": "setsid -f hyde-shell quickapps", 
        "interval": 86400,
        "tooltip": true
    }
}