#!/usr/bin/env bash
# This script resolves $PATHS and LIB_DIR specific to hyde.
# @name: hyde-shell
# @short: HyDE Command-Line Interface and Script Runner
# @ver: 1.1.0
# @usage: hyde-shell [command] [args]
# @global.flag: -h,--help | Show this help message
# @global.flag: -v,--version | Show version information
# @cmd: help
# @cmd.alias: -h
# @cmd.desc: Show help for hyde-shell commands and scripts
# @cmd.opt: <topic> | Show detailed help for a command or script
# @cmd: man
# @cmd.desc: Render metadata in man-style format
# @cmd.opt: <topic> | Render a man-style page for a command or script
# @cmd: reload
# @cmd.alias: -r
# @cmd.desc: Reload HyDE assets or environment
# @cmd.opt: all | Reload all components
# @cmd.opt: cache | Clear and rebuild asset cache
# @cmd.opt: theme | Apply new color scheme
# @cmd.opt: python | Reload Python environment
# @cmd.opt: lua | Reload Lua environment
# @cmd: scripts
# @cmd.alias: -s
# @cmd.desc: List available scripts
# @cmd: wallbash
# @cmd.desc: Execute a wallbash script by name
# @cmd: version
# @cmd.alias: -v
# @cmd.desc: Show version information
# @cmd: release-notes
# @cmd.desc: Show latest release notes
# @cmd: completion
# @cmd.alias: completions
# @cmd.desc: Shell completion helper utilities
# @cmd.opt: --list-builtins | List built-in completions
# @cmd.opt: --list-script | List script completions
# @cmd.opt: --list-script-path | List script paths
# @cmd.opt: --list-all | List all autocomplete options
# @cmd.opt: bash | Generate bash completion
# @cmd.opt: zsh | Generate zsh completion
# @cmd.opt: fish | Generate fish completion
# @cmd.opt: --help | Show completion help
# @cmd: validate
# @cmd.desc: Validate HyDE configuration files
# @cmd: pyinit
# @cmd.desc: Initialize Python virtual environment
# @cmd: uv
# @cmd.desc: Manage Python packages via uv
# @cmd.opt: install | Install a package
# @cmd.opt: uninstall | Uninstall a package
# @cmd.opt: remove | Remove a package
# @cmd.opt: list | List installed packages
# @cmd: init
# @cmd.desc: Source shell initialization environment
# @cmd: logout
# @cmd.desc: Log out of the current desktop session
# @cmd: lock-session
# @cmd.desc: Lock the current session
# @cmd: pypr
# @cmd.desc: PyPR / Pyprland helper utilities
# @cmd.opt: help | Show pypr help
# @cmd.opt: reload | Reload pypr config
# @cmd.opt: toggle | Toggle pypr window
# @cmd.opt: hide | Hide pypr window
# @cmd.opt: show | Show pypr window
# @cmd.opt: expose | Expose pypr windows
# @cmd: luainit
# @cmd.desc: Initialize Lua virtual environment
# @cmd: luarocks
# @cmd.desc: Manage Lua packages via luarocks
# @cmd.opt: install | Install a rock
# @cmd.opt: remove | Remove a rock
# @cmd.opt: list | List installed rocks
# @cmd.opt: search | Search for rocks
# @cmd.opt: show | Show rock info
# @cmd.opt: help | Show luarocks help

# shellcheck disable=SC1091
# shellcheck disable=SC2086
# shellcheck disable=SC1090

python_initialized() {
    local python_script="${LIB_DIR}/hyde/pyutils/python_env.py"
    local venv="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env"

    if [[ -x "${venv}/bin/python" ]]; then
        source "${venv}/bin/activate"
        "${venv}/bin/python" "${python_script}" sync >/dev/null 2>&1 && return 0
        echo "Sync failed; rebuilding Python environment..."
        "${venv}/bin/python" "${python_script}" rebuild
        return $?
    fi

    echo "Python environment not found; creating..."
    python3 "${python_script}" create >/dev/null 2>&1 && return 0
    echo "Create failed; attempting rebuild..."
    python3 "${python_script}" rebuild
}

python_activate() {
    local python_env="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env/bin/activate"
    if [[ -r "${python_env}" ]]; then
        source "${python_env}"
    else
        printf "Warning: Python virtual environment not found at %s\n" "${python_env}"
        printf "You may need to run 'hyde-shell pyinit' to set it up.\n"
        python_initialized
    fi
}

lua_initialized() {
    python_activate
    python3 "${LIB_DIR}/hyde/pyutils/lua_env.py" sync ||
        python3 "${LIB_DIR}/hyde/pyutils/lua_env.py" rebuild
}

initialized() {
    cat <<EOF
HYDE_SHELL_INIT=1
BIN_DIR="${BIN_DIR}"
LIB_DIR="${LIB_DIR}"
SHARE_DIR="${SHARE_DIR}"
PATH=${PATH}
HYDE_SCRIPTS_PATH=${HYDE_SCRIPTS_PATH}
export BIN_DIR LIB_DIR SHARE_DIR PATH HYDE_SCRIPTS_PATH HYDE_SHELL_INIT
EOF
    command cat "${LIB_DIR}/hyde/globalcontrol.sh"
}

USAGE() {
    local cols
    cols=$(tput cols 2>/dev/null || echo 80)
    local sep
    sep=$(printf '─%.0s' $(seq 1 "$((cols - 2))"))

    local _R=$'\e[0m' _BOLD=$'\e[1m' _DIM=$'\e[2m' _CYAN=$'\e[36m'

    printf '\n%s  HyDE Shell%s\n' "$_BOLD" "$_R"
    printf '  %s%s%s\n\n' "$_DIM" "$sep" "$_R"

    printf '  %sUSAGE%s\n' "$_BOLD" "$_R"
    printf '    hyde-shell %s[command]%s %s[args]%s\n\n' "$_CYAN" "$_R" "$_DIM" "$_R"

    printf '  %sCOMMANDS%s\n' "$_BOLD" "$_R"
    local cmds=(
        'help, -h [topic]' 'Show help (or topic-specific help)'
        'man <topic>' 'Show a man-style page for a command or script'
        '-r, reload' 'Reload HyDE'
        '-s, scripts' 'List available scripts'
        'app <args>' 'Launch an application through app.sh'
        'wallbash <script>' 'Execute a wallbash script'
        'version, -v' 'Show version information'
        'release-notes' 'Show release notes'
        'completion <shell>' 'Shell completion (bash|zsh|fish, --list-*)'
        'validate [args]' 'Validate HyDE configuration'
        'pyinit' 'Initialize the Python environment'
        'uv <cmd> [pkg]' 'Manage Python packages (install|uninstall|list)'
        'luainit' 'Initialize the Lua environment'
        'luarocks <cmd>' 'Manage Lua packages (install|remove|list|search|show)'
        'pypr <cmd>' 'Pyprland helper (toggle|show|hide|expose|reload)'
        'init' 'Source initialization script'
        'logout' 'Log out of the current session'
        'lock-session' 'Lock the current session'
    )
    for ((i = 0; i < ${#cmds[@]}; i += 2)); do
        printf '    %s%-26s%s %s\n' "$_CYAN" "${cmds[i]}" "$_R" "${cmds[i + 1]}"
    done
    printf '\n'

    printf '  %sSCRIPTS%s\n' "$_BOLD" "$_R"
    printf '    Run any script by name (without extension):\n'
    printf '      %shyde-shell theme.switch%s\n' "$_DIM" "$_R"
    printf '      %shyde-shell wallpaper%s\n\n' "$_DIM" "$_R"
    printf '    Use %shyde-shell -s%s to list all available scripts.\n\n' "$_CYAN" "$_R"

    printf '  %s%s%s\n\n' "$_DIM" "$sep" "$_R"
}

call_wallbashScript() {
    # Accept a name with or without ".sh": the usage fallback below lists
    # scripts by their real filename (e.g. "spotify.sh"), which is what a
    # user copies -- but the -name match further down always appends its
    # own ".sh", so passing that exact listed name looked for
    # "spotify.sh.sh", found nothing, and silently fell through to the same
    # usage/help text instead of running the script (#1801).
    local scriptName=${1%.sh}
    shift
    local args=("${@}")
    local dirs=("${WALLBASH_DIRS[@]}")
    sanitized_dirs=()
    for dir in "${dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            sanitized_dirs+=("$dir")
        fi
    done
    dirs=("${sanitized_dirs[@]}")
    # A missing or empty name must never reach `find`: an empty scriptName
    # would search for the literal filename ".sh", which a real wallbash
    # script directory could legitimately contain -- executing it instead
    # of showing usage for what is clearly not a real request.
    script_path=""
    if [[ -n "$scriptName" ]]; then
        script_path=$(find -L "${dirs[@]}" -type f -path "*/scripts/*" -name "${scriptName}.sh" -exec echo {} \; -quit)
    fi

    for func in $(compgen -A function); do
        export -f "${func?}"
    done

    if [[ -n "$script_path" ]]; then
        "$script_path" "${args[@]}"
    else
        echo "Usage: wallbash [script-name] [args]"
        echo "Executes the specified wallbash script with the provided arguments."
        echo "Available scripts:"
        for dir in "${dirs[@]}"; do
            if [[ -d "$dir" ]]; then
                echo -e "\n[ $dir ]"
                find -L "$dir" -type f -path "*/scripts/*" -name "*.sh" -exec basename {} \;
            fi
        done
    fi
}

hyde_reload() {
    python_activate
    python3 "${LIB_DIR}/hyde/reload.py" "${@}"
}

list_script_path() {
    IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
    declare -A _seen_dirs
    for dir in "${RAW_DIRS[@]}"; do
        [[ -z "$dir" ]] && continue
        [[ -n "${_seen_dirs[$dir]}" ]] && continue
        _seen_dirs["$dir"]=1
        # Added -name "*.lua" to discoverable scripts
        [[ -d "$dir" ]] && find -L "$dir" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" -o -name "*.lua" \) -exec echo {} \;
    done
}

list_script() {
    list_script_path | while IFS= read -r script_path; do
        [[ -z "$script_path" ]] && continue
        # Only include scripts that have @name: metadata (public scripts)
        if head -n 50 "$script_path" | grep -qE '^#\s*@name:\s'; then
            basename "$script_path"
        fi
    done | sort -u
}

##
# Reads the KEY='value' lines version.sh writes, as data. Sourcing the file
# ran backticks in a commit message. A value may span lines and holds a
# quote as '\''; a line that does not parse is skipped.
##
load_version_file() {
    local rest key value
    local keys="CLONE_PATH|BRANCH|REMOTE|VERSION|VERSION_LAST_CHECKED|VERSION_COMMIT_MSG|COMMIT_HASH|RELEASE_NOTES"
    local re="^(HYDE_($keys))='(([^']|'\\\\'')*)'"
    rest=$(<"$1") || return 1
    while [[ -n $rest ]]; do
        if [[ $rest =~ $re ]] && [[ ${rest:${#BASH_REMATCH[0]}:1} == $'\n' || ${#rest} -eq ${#BASH_REMATCH[0]} ]]; then
            key=${BASH_REMATCH[1]}
            value=${BASH_REMATCH[3]//"'\\''"/"'"}
            printf -v "$key" '%s' "$value"
            rest=${rest:${#BASH_REMATCH[0]}}
        fi
        [[ $rest == *$'\n'* ]] && rest=${rest#*$'\n'} || rest=""
    done
}

get_version() {
    if [[ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version" ]]; then
        echo "HyDE version file not found. Please update HyDE."
        exit 1
    fi
    load_version_file "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version"
    cat <<VERSION
HyDE, your Development Environment

Version: $HYDE_VERSION
Branch: $HYDE_BRANCH
Commit Hash: $HYDE_COMMIT_HASH
Remote: $HYDE_REMOTE
Restore Date: $HYDE_VERSION_LAST_CHECKED
Last Commit Message: $HYDE_VERSION_COMMIT_MSG

Tools:
hydectl: $(hydectl version 2>/dev/null || echo "hydectl not found")
$(hyprland -v 2>/dev/null | head -n1 || echo "hyprland not found")
$(if hyprctl_output=$(hyprctl version 2>/dev/null | head -n1); then echo "$hyprctl_output (Running Instance)"; else echo "hyprctl not found or not running"; fi)
$(hyde-ipc --version 2>/dev/null || echo "hyde-ipc not found")

HyDE updates every Friday, so please check for updates regularly.
Run 'hyde-shell release-notes' to see the latest changes.
HyDE is a community-driven project, and contributions are welcome.
VERSION
}

get_release_notes() {
    if [[ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version" ]]; then
        echo "HyDE version file not found. Please update HyDE."
        exit 1
    fi
    load_version_file "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version"
    echo "HyDE Release Notes:"
    echo "$HYDE_RELEASE_NOTES"
}

hyde-logout() {
    if uwsm check is-active; then
        uwsm stop
    elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE}" ]]; then
        if command -v hyprshutdown >/dev/null 2>&1; then
            hyprshutdown --top-label "Stay HyDErated!🫧"
        else
            hyprctl dispatch 'hl.dsp.exit()'
        fi
    fi
}

run_command() {
    IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
    declare -A seen_dirs
    SCRIPT_DIRS=()
    for dir in "${RAW_DIRS[@]}"; do
        [[ -z "$dir" ]] && continue
        [[ -n "${seen_dirs[$dir]}" ]] && continue
        seen_dirs["$dir"]=1
        [[ -d "$dir" ]] && SCRIPT_DIRS+=("$dir")
    done

    # `pm` is the Python rewrite. pm.sh stays for the installer and pkg_installed,
    # which call it by name, but would otherwise win here as the shell script.
    [[ $1 == pm ]] && set -- pm.py "${@:2}"

    # Lua is resolved before shell, so a script left behind by an older release
    # cannot shadow the implementation that replaced it.
    for dir in "${SCRIPT_DIRS[@]}"; do
        if [[ -f "$dir/${1}.lua" ]]; then
            l_env="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env"
            if [[ ! -d "$l_env" ]]; then
                print_log -warn "Lua environment not found!" " Please run 'hyde-shell luainit' to set up the environment."
                send_notifs "Lua environment not found!" "Please run 'hyde-shell luainit' to set up the environment."
                exit 1
            fi
            __hyde_lua_ver_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyde/lua_ver"
            if [[ -f "$__hyde_lua_ver_file" ]]; then
                read -r lua_ver _ <"$__hyde_lua_ver_file"
            elif command -v lua &>/dev/null; then
                read -r lua_ver _ < <(lua -e 'io.write(_VERSION:match("%d+%.%d+"))')
                echo "$lua_ver" >"$__hyde_lua_ver_file"
            fi
            unset __hyde_lua_ver_file
            export LUA_PATH="$l_env/share/lua/$lua_ver/?.lua;$l_env/share/lua/$lua_ver/?/init.lua;$LUA_PATH"
            export LUA_CPATH="$l_env/lib/lua/$lua_ver/?.so;$LUA_CPATH"
            exec lua "$dir/${1}.lua" "${@:2}"
        elif [[ -f "$dir/${1}.sh" ]]; then
            exec bash "$dir/${1}.sh" "${@:2}"
        elif [[ -f "$dir/${1}.py" ]]; then
            exec "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env/bin/python" "$dir/${1}.py" "${@:2}"
        elif [[ -f "$dir/${1}" && -x "$dir/${1}" ]]; then
            exec "$dir/${1}" "${@:2}"
        fi
    done

    if [[ -f "$1" && -x "$1" ]]; then
        exec "$1" "${@:2}"
    else
        suggest_command "$1" >&2
        exit 1
    fi
}

# Points a mistyped command at the closest builtins and scripts instead of
# dumping the whole script list.
suggest_command() {
    local builtins=(app completion help init lock-session logout luainit luarocks man pyinit pypr
        release-notes reload scripts uv validate version wallbash)
    local matches
    matches=$({
        printf '%s\n' "${builtins[@]}"
        list_script_path | sed -E 's|.*/||; s/\.(sh|py|lua)$//'
    } | python3 -c '
import difflib, sys
names = sorted(set(sys.stdin.read().split()))
print("\n".join(difflib.get_close_matches(sys.argv[1], names, n=3, cutoff=0.6)))
' "$1" 2>/dev/null)

    printf "hyde-shell: '%s' is not a command or script.\n" "$1"
    if [[ -n "$matches" ]]; then
        printf 'Did you mean:\n'
        printf '    %s\n' $matches
    fi
    printf "Run 'hyde-shell -s' to list scripts, or 'hyde-shell --help' for commands.\n"
}

run_uv() {
    local project_dir="${LIB_DIR}/hyde"
    local venv_path="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env"
    shift
    local subcmd="${1:-help}"
    shift 2>/dev/null || true
    case "$subcmd" in
    install)
        UV_PROJECT_ENVIRONMENT="$venv_path" uv add "$@" --project "$project_dir"
        ;;
    uninstall | remove)
        UV_PROJECT_ENVIRONMENT="$venv_path" uv remove "$@" --project "$project_dir"
        ;;
    list)
        UV_PROJECT_ENVIRONMENT="$venv_path" uv pip list --python "${venv_path}/bin/python"
        ;;
    *)
        echo "Usage: hyde-shell uv [install|uninstall|list] [packages...]"
        ;;
    esac
}

run_luarocks() {
    shift
    local lua_env_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env"
    if command -v luarocks >/dev/null 2>&1; then
        luarocks --tree "${lua_env_dir}" "$@"
    else
        echo "luarocks not found in your system."
    fi
}

run_pypr() {
    python_activate
    shift

    if command -v pypr >/dev/null 2>&1; then
        socket_path="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.pyprland.sock"
        if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/pypr/config.toml" ]]; then
            send_notifs "Missing config.toml" "Please create a config.toml in config dir."
            exit 1
        fi

        if [[ -S "$socket_path" ]] && pgrep -u "$USER" pypr >/dev/null 2>&1; then
            local -a msg=("$@")
            ((${#msg[@]} == 0)) && msg=("help")
            if ! printf '%s\n' "${msg[*]}" | nc -N -U "$socket_path" 2>/dev/null; then
                if ! printf '%s\n' "${msg[*]}" | socat - UNIX-CONNECT:"$socket_path" 2>/dev/null; then
                    if ! printf '%s\n' "${msg[*]}" | ncat -U "$socket_path" 2>/dev/null; then
                        if ! pypr "${msg[@]}"; then
                            print_log -sec "pypr" "Error communicating with socket: $socket_path"
                            exit 1
                        fi
                    fi
                fi
            fi
        else
            print_log -sec "pypr" "PyPR is not running properly, starting fresh"
            rm -f "$socket_path"
            exec app.sh -t service pypr
        fi
    else
        UV_PROJECT_ENVIRONMENT="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env" uv add "pyprland==3.3.1" --project "${LIB_DIR}/hyde"
    fi
}

list_scripts_pretty() {
    local cols
    cols=$(tput cols 2>/dev/null || echo 80)
    local sep
    sep=$(printf '─%.0s' $(seq 1 "$((cols - 2))"))

    local _R=$'\e[0m' _BOLD=$'\e[1m' _DIM=$'\e[2m'
    local _VIOLET=$'\e[35m' _GREEN=$'\e[92m'

    IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
    declare -A seen_dirs
    local SCRIPT_DIRS=()

    for dir in "${RAW_DIRS[@]}"; do
        [[ -z "$dir" ]] && continue
        [[ -n "${seen_dirs[$dir]}" ]] && continue
        seen_dirs["$dir"]=1
        [[ -d "$dir" ]] && SCRIPT_DIRS+=("$dir")
    done

    local total=0
    printf '\n%s  Available Scripts%s\n' "$_BOLD" "$_R"
    printf '  %s%s%s\n' "$_DIM" "$sep" "$_R"

    for dir in "${SCRIPT_DIRS[@]}"; do
        # Script names as hyde-shell runs them: no extension, one entry per name
        local names=()
        mapfile -t names < <(find -L "$dir" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" -o -name "*.lua" \) \
            -printf '%f\n' 2>/dev/null | sed -E 's/\.(sh|py|lua)$//' | sort -u)

        [[ ${#names[@]} -eq 0 ]] && continue
        printf '\n  %s%s%s\n' "$_VIOLET" "$dir" "$_R"

        # Group "theme.switch", "theme.select", ... under "theme"
        unset groups
        declare -A groups
        for name in "${names[@]}"; do
            groups["${name%%.*}"]+="$name "
        done

        # Green names are runnable; a dim heading only gathers related scripts
        for key in $(printf "%s\n" "${!groups[@]}" | sort); do
            read -ra items <<<"${groups[$key]}"
            if [[ ${#items[@]} -eq 1 ]]; then
                printf "    %s%s%s\n" "$_GREEN" "${items[0]}" "$_R"
            else
                if [[ "${items[0]}" == "$key" ]]; then
                    printf "    %s%s%s\n" "$_GREEN" "$key" "$_R"
                else
                    printf "    %s%s%s\n" "$_DIM" "$key" "$_R"
                fi
                for item in "${items[@]}"; do
                    [[ "$item" == "$key" ]] && continue
                    printf "      %s%s%s\n" "$_GREEN" "$item" "$_R"
                done
            fi
            ((total += ${#items[@]}))
        done
    done

    local dir_word="directories"
    ((${#SCRIPT_DIRS[@]} == 1)) && dir_word="directory"

    printf '\n  %s%s%s\n' "$_DIM" "$sep" "$_R"
    printf '  %s%d scripts across %d %s%s\n\n' "$_DIM" "$total" "${#SCRIPT_DIRS[@]}" "$dir_word" "$_R"
}

lock_session() {
    if busctl --user list | grep -q "org.freedesktop.ScreenSaver"; then
        echo "Using org.freedesktop.ScreenSaver for locking"
        loginctl lock-session
    else
        lockscreen.sh
    fi
}

# -----------------------------------------------------------------

if [[ -z "${BASH_SOURCE[0]}" ]]; then
    EXECUTABLE="${0}"
else
    EXECUTABLE="${BASH_SOURCE[0]}"
fi

BIN_DIR=$(dirname "$(which "${EXECUTABLE:-hyde-shell}")")
LIB_DIR=$(realpath "${BIN_DIR}/../lib")
SHARE_DIR=$(realpath "${BIN_DIR}/../share")
# Prepend hyde paths to PATH only if not already present
for _p in "$LIB_DIR/hyde" "$BIN_DIR" "${XDG_CONFIG_HOME:-$HOME/.config}/hyde/scripts"; do
    [[ ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
unset _p
# Define hyde scripts search paths (colon-separated, user configurable)
HYDE_SCRIPTS_PATH="${HYDE_SCRIPTS_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/hyde/scripts:${LIB_DIR}/hyde}:${XDG_DATA_HOME:-$HOME/.local/share}/waybar/scripts:${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts"
export BIN_DIR LIB_DIR SHARE_DIR PATH HYDE_SCRIPTS_PATH

# -----------------------------------------------------------------

[[ -d "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyde" ]] || mkdir -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyde"

case "$1" in
app)
    # app launches a service/scope that outlives this shell via exec, so
    # anything it needs from HyDE's generated config (e.g. config.toml ->
    # env vars like BATTERY_NOTIFY_DOCK) has to be sourced and exported
    # before the exec below -- this path used to skip globalcontrol.sh
    # entirely and reach it only on the fallback branch further down,
    # silently launching every app-managed service without it (#1951).
    if ! source "${LIB_DIR}/hyde/globalcontrol.sh"; then
        echo "Error: Could not load HyDE, broken installation?"
        exit 1
    fi
    export PATH="${HYDE_SCRIPTS_PATH}:${PATH}"
    [[ "${HYDEPY}" -eq 1 ]] && python_activate
    shift
    exec app.sh "$@"
    ;;
init | --init)
    initialized
    exit 0
    ;;
lock-session)
    lock_session
    exit 0
    ;;
*)
    export HYDE_SHELL_INIT=1
    ;;
esac

if ! source "${LIB_DIR}/hyde/globalcontrol.sh"; then
    echo "Error: Could not load HyDE, broken installation?"
    exit 1
fi

# -----------------------------------------------------------------

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    case $1 in
    logout)
        hyde-logout
        ;;
    pypr)
        run_pypr "${@}"
        exit 0
        ;;
    uv)
        run_uv "${@}"
        exit 0
        ;;
    luarocks)
        run_luarocks "${@}"
        exit 0
        ;;
    -r | reload)
        shift
        hyde_reload "${@}"
        ;;
    wallbash)
        shift
        call_wallbashScript "$@"
        ;;

    completion | completions)
        # Delegate all completion operations to the Python backend
        python_activate
        python3 "${LIB_DIR}/hyde/completions.py" "${@:2}"
        exit $?
        ;;
    --release-notes | release-notes)
        get_release_notes
        ;;
    --version | version | -v)
        get_version
        ;;
    help)
        shift
        if [[ $# -gt 0 ]]; then
            python3 "${LIB_DIR}/hyde/help.py" "$@"
            exit $?
        fi
        USAGE
        ;;
    man)
        shift
        python3 "${LIB_DIR}/hyde/man.py" "$@"
        exit $?
        ;;
    --help | -h)
        USAGE
        ;;
    -s | scripts)
        list_scripts_pretty
        ;;
    validate)
        shift
        if command -v hyde-config >/dev/null 2>&1; then
            hyde-config -no-daemon "${@}"
        else
            echo "hyde-config not found."
        fi
        exit 0
        ;;
    pyinit)
        python_initialized
        ;;
    luainit)
        lua_initialized
        ;;
    "")
        for func in $(compgen -A function); do
            export -f "${func?}"
        done
        ;;
    *)
        run_command "$@"
        ;;
    esac
fi
